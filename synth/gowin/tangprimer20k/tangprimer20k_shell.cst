########################################################################################
# DDR3, one 16-bit 1Gb chip (gowin-ddr3 ddr3_phy_slow, as in its tang-primer-20k example).
# CK and DQS pairs are LVCMOS15D for the ELVDS buffers; no ODT, so plain LVCMOS15.
IO_LOC "ddr_addr[0]"     IOL45A;
IO_LOC "ddr_addr[1]"     IOB02A;
IO_LOC "ddr_addr[2]"     IOB03A;
IO_LOC "ddr_addr[3]"     IOL35A;
IO_LOC "ddr_addr[4]"     IOL47A;
IO_LOC "ddr_addr[5]"     IOL53A;
IO_LOC "ddr_addr[6]"     IOB08A;
IO_LOC "ddr_addr[7]"     IOL38A;
IO_LOC "ddr_addr[8]"     IOB07A;
IO_LOC "ddr_addr[9]"     IOL31A;
IO_LOC "ddr_addr[10]"    IOB36A;
IO_LOC "ddr_addr[11]"    IOL40A;
IO_LOC "ddr_addr[12]"    IOB04A;
IO_LOC "ddr_addr[13]"    IOL29A;
IO_LOC "ddr_ba[0]"    IOB26A;
IO_LOC "ddr_ba[1]"    IOB09A;
IO_LOC "ddr_ba[2]"    IOB35A;
IO_LOC "ddr_ras_n"    IOB52A;
IO_LOC "ddr_cas_n"    IOB54A;
IO_LOC "ddr_we_n"     IOB30A;
IO_LOC "ddr_cs_n"     IOB50A;
IO_LOC "ddr_dm[0]"    IOB24A;
IO_LOC "ddr_dm[1]"    IOB40A;
IO_LOC "ddr_dq[0]"    IOB20A;
IO_LOC "ddr_dq[1]"    IOB22A;
IO_LOC "ddr_dq[2]"    IOB18A;
IO_LOC "ddr_dq[3]"    IOB19A;
IO_LOC "ddr_dq[4]"    IOB12A;
IO_LOC "ddr_dq[5]"    IOB14A;
IO_LOC "ddr_dq[6]"    IOB16A;
IO_LOC "ddr_dq[7]"    IOB13A;
IO_LOC "ddr_dq[8]"    IOB42A;
IO_LOC "ddr_dq[9]"    IOB39A;
IO_LOC "ddr_dq[10]"   IOB41A;
IO_LOC "ddr_dq[11]"   IOB38A;
IO_LOC "ddr_dq[12]"   IOB45A;
IO_LOC "ddr_dq[13]"   IOB32A;
IO_LOC "ddr_dq[14]"   IOB44A;
IO_LOC "ddr_dq[15]"   IOB43A;
IO_LOC "ddr_dqs[0]" IOB21A;
IO_LOC "ddr_dqs_n[0]" IOB21B;
IO_LOC "ddr_dqs[1]" IOB37A;
IO_LOC "ddr_dqs_n[1]" IOB37B;
IO_LOC "ddr_ck"       IOB27A;
IO_LOC "ddr_ck_n"     IOB27B;
IO_LOC "ddr_cke"      IOB34A;
IO_LOC "ddr_odt"      IOB48A;
IO_LOC "ddr_reset_n"  IOL33A;
IO_PORT "ddr_addr[0]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[1]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[2]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[3]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[4]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[5]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[6]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[7]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[8]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[9]"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[10]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[11]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[12]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_addr[13]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_ba[0]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_ba[1]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_ba[2]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_ras_n"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_cas_n"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_we_n"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_cs_n"     IO_TYPE=LVCMOS15;
IO_PORT "ddr_dm[0]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dm[1]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[0]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[1]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[2]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[3]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[4]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[5]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[6]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[7]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[8]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[9]"    IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[10]"   IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[11]"   IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[12]"   IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[13]"   IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[14]"   IO_TYPE=LVCMOS15;
IO_PORT "ddr_dq[15]"   IO_TYPE=LVCMOS15;
IO_PORT "ddr_dqs[0]" IO_TYPE=LVCMOS15D;
IO_PORT "ddr_dqs_n[0]" IO_TYPE=LVCMOS15D;
IO_PORT "ddr_dqs[1]" IO_TYPE=LVCMOS15D;
IO_PORT "ddr_dqs_n[1]" IO_TYPE=LVCMOS15D;
IO_PORT "ddr_ck"       IO_TYPE=LVCMOS15D;
IO_PORT "ddr_ck_n"     IO_TYPE=LVCMOS15D;
IO_PORT "ddr_cke"      IO_TYPE=LVCMOS15;
IO_PORT "ddr_odt"      IO_TYPE=LVCMOS15;
IO_PORT "ddr_reset_n"  IO_TYPE=LVCMOS15;
