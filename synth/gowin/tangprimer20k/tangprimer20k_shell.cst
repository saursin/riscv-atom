################################################################################
# Clock
IO_LOC  "clk_27mhz_i" H11;
IO_PORT "clk_27mhz_i" IO_TYPE=LVCMOS33;

################################################################################
# UART
IO_LOC  "uart_rx_i" T13;    # FPGA_TX
IO_LOC  "uart_tx_o" M11;    # FPGA_RX

IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33;

