################################################################################
# Orange LEDs
IO_LOC  "led_n_o[0]" C13;
IO_LOC  "led_n_o[1]" A13;
IO_LOC  "led_n_o[2]" N16;
IO_LOC  "led_n_o[3]" N14;
IO_LOC  "led_n_o[4]" L14;
IO_LOC  "led_n_o[5]" L16;
IO_PORT "led_n_o[0]" IO_TYPE=LVCMOS33;
IO_PORT "led_n_o[1]" IO_TYPE=LVCMOS33;
IO_PORT "led_n_o[2]" IO_TYPE=LVCMOS33;
IO_PORT "led_n_o[3]" IO_TYPE=LVCMOS33;
IO_PORT "led_n_o[4]" IO_TYPE=LVCMOS33;
IO_PORT "led_n_o[5]" IO_TYPE=LVCMOS33;

################################################################################
# Push Buttons
IO_LOC  "btn_n_i[0]" T10;  # S0
IO_LOC  "btn_n_i[1]" T3;   # S1
IO_LOC  "btn_n_i[2]" T2;   # S2
IO_LOC  "btn_n_i[3]" D7;   # S3
IO_LOC  "btn_n_i[4]" C7;   # S4
IO_PORT "btn_n_i[0]" IO_TYPE=LVCMOS33;
IO_PORT "btn_n_i[1]" IO_TYPE=LVCMOS15;   # 1.5 V bank (shared with DDR3)
IO_PORT "btn_n_i[2]" IO_TYPE=LVCMOS15;   # 1.5 V bank (shared with DDR3)
IO_PORT "btn_n_i[3]" IO_TYPE=LVCMOS15;   # 1.5 V bank (shared with DDR3)
IO_PORT "btn_n_i[4]" IO_TYPE=LVCMOS15;   # 1.5 V bank (shared with DDR3)

################################################################################
# Switches (drive high when ON, float when OFF: need pull-downs)
IO_LOC  "sw_i[0]" E9;  # DIP switch 1
IO_LOC  "sw_i[1]" E8;  # DIP switch 2
IO_LOC  "sw_i[2]" T4;  # DIP switch 3
IO_LOC  "sw_i[3]" T5;  # DIP switch 4
IO_PORT "sw_i[0]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;   # 1.5 V bank (shared with DDR3)
IO_PORT "sw_i[1]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;   # 1.5 V bank (shared with DDR3)
IO_PORT "sw_i[2]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;   # 1.5 V bank (shared with DDR3)
IO_PORT "sw_i[3]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;   # 1.5 V bank (shared with DDR3)

